<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<title>Giriş</title>
<style>
  body {
    margin: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Arial, sans-serif;
  }
  #login {
    text-align: center;
  }
  #content {
    display: none;
    font-size: 10vw;
    font-weight: bold;
  }
  input {
    padding: 10px;
    margin: 5px;
    font-size: 16px;
  }
  button {
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
  }
</style>
</head>
<body>

<div id="login">
  <h2>Üyelik Girişi</h2>
  <input type="text" id="user" placeholder="Kullanıcı adı"><br>
  <input type="password" id="pass" placeholder="Şifre"><br>
  <button onclick="login()">Giriş Yap</button>
</div>

<div id="content">
  OSTURDUM
</div>

<script>
  function login() {
    const user = document.getElementById("user").value;
    const pass = document.getElementById("pass").value;

    if (user === "admin" && pass === "1234") {
      document.getElementById("login").style.display = "none";
      document.getElementById("content").style.display = "block";
    } else {
      alert("Hatalı giriş");
    }
  }
</script>

</body>
</html>
